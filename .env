# OptoReview Analytics Configuration
# Cloudflare Worker URL for access logging
VITE_ANALYTICS_WORKER_URL=https://optoreview-analytics.minqiu.workers.dev

# Admin panel password (default: optoreview2025)
VITE_ADMIN_PASSWORD=optoreview2025

# API Key for querying analytics data (must match the API_KEY set in Cloudflare Worker)
VITE_ANALYTICS_API_KEY=optoreview_admin_2025
